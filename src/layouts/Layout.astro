---
import '@/styles/tailwind.css'
import '@/styles/main.scss'
import Menu from '@/components/Menu/Menu.svelte'
import BackgroundMusic from '@/components/BackgroundMusic.astro'
import { ClientRouter } from 'astro:transitions'
import { useMenu } from '@/utils/useMenu'
import type { AuthorMember } from '@/constants/authors'

const { menu } = await useMenu()
const currentPath = Astro.url.pathname

// The display face is self-hosted so the brand does not depend on remote font loading.
const FONT_CSS_URL = 'https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300..700&family=JetBrains+Mono:wght@400;500&display=swap'

interface Props {
  title?: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  publishedTime?: string
  author?: string
  authors?: AuthorMember[]
  tags?: string[]
  immersive?: boolean
  visualHome?: boolean
}

const SITE_NAME = 'Jeremy'

const {
  title = SITE_NAME,
  description = 'Jeremy 的日常、想像，與沿途的風景。',
  image = '/icon-512.png',
  type = 'website',
  publishedTime,
  author = SITE_NAME,
  authors,
  tags = [],
  immersive = currentPath === '/',
  visualHome = false,
} = Astro.props

const pageTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL(image, Astro.site).href
const twitterCard = image === '/icon-512.png' ? 'summary' : 'summary_large_image'
const articleAuthors = authors
  ? authors.filter(member => member.kind === 'person').map(member => ({ '@type': 'Person', name: member.name }))
  : [{ '@type': 'Person', name: author }]

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      url: canonicalURL,
      author: articleAuthors.length === 1 ? articleAuthors[0] : articleAuthors,
      ...(authors?.length ? { creditText: authors.map(member => member.kind === 'ai' ? `${member.name}（AI 協作）` : member.name).join('、') } : {}),
      publisher: { '@type': 'Person', name: SITE_NAME },
      ...(publishedTime ? { datePublished: publishedTime } : {}),
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      url: new URL('/', Astro.site).href,
      description,
    }
---

<!doctype html>
<html lang="zh-TW" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter fallback="swap" />

    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-X57D2M0BZX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      gtag('js', new Date())
      gtag('config', 'G-X57D2M0BZX')
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <title>{pageTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {type === 'article' && <meta property="article:author" content={author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <link rel="icon" href="/favicon.ico?v=20261105-paper-ink" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261105-paper-ink" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=20261105-paper-ink" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=20261105-paper-ink" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="theme-color" content={visualHome ? '#f9f8f4' : '#f4f3ef'} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/urbanist-variable.woff2" />
    <link rel="stylesheet" href="/fonts/iansui.css" />
    {/* Async font CSS keeps the huge CJK stylesheets off the critical render path */}
    <link rel="preload" as="style" href={FONT_CSS_URL} />
    <link rel="stylesheet" href={FONT_CSS_URL} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={FONT_CSS_URL} />
    </noscript>
    <slot name="head" />
  </head>

  <body
    transition:animate="none"
    class="
      min-h-screen
      flex
      flex-col
      text-ink
      bg-paper
      antialiased
      selection:bg-brand/20
      selection:text-ink
      relative
    "
  >
    <a class="skip-link" href="#main-content">跳至內容</a>
    <BackgroundMusic />
    <Menu client:load rootItems={menu} currentPath={currentPath} {visualHome} />
    {visualHome && <slot name="cover" />}
    <main id="main-content" class:list={['site-main', { 'site-main-immersive': immersive }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <a href="/" class="footer-brand" aria-label="Jeremy 首頁">
        <span class="site-brand-name">Jeremy</span>
        <span class="site-brand-studio">Solunastre Studio</span>
      </a>
      <div class="footer-meta"><span>© {new Date().getFullYear()} Jeremy</span></div>
    </footer>

    <style is:global>
      :root {
        color-scheme: light;
      }

      html {
        font-family: var(--font-body);
        scroll-behavior: smooth;
      }

      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }

      ::-webkit-scrollbar-track {
        background: transparent;
      }

      ::-webkit-scrollbar-thumb {
        background: var(--color-line);
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-ink-faint);
      }

      html, body {
        overflow-x: clip;
      }
    </style>
  </body>
</html>
