---
import Layout from '@/layouts/Layout.astro'
import { AUTHORS } from '@/constants/authors'

const authors = AUTHORS.filter(author => !author.isHiddenFromAbout)
const platformLabel = (platform: string) => ({ github: 'GitHub', linkedin: 'LinkedIn', ithome: 'iThome', npm: 'npm' }[platform] || platform)
---

<Layout title='關於' description='關於 Jeremy，以及這個記錄日常、想像與生活的部落格。'>
  <div class='about-page' data-about-page>
    <header class='about-heading'><h1>關於 Jeremy</h1></header>
    {authors.map((author, authorIndex) => {
      const [quote, quoteAuthor] = (author.summary || '').split('\n')
      return <article class='author-profile' data-author-profile>
        <div class='profile-intro'>
          <div class='profile-introduction'>
            {quote && <figure class='author-quote'><blockquote>{quote}</blockquote>{quoteAuthor && <figcaption>{quoteAuthor}</figcaption>}</figure>}
            {author.currentRole && <ul class='roles' aria-label={`${author.name} 的目前職務`}>{author.currentRole.map(role => <li>{role}</li>)}</ul>}
          </div>
          <figure class='profile-portrait'>
            <img src={author.imgPath} alt={author.name} width='300' height='300' />
            <figcaption>{author.name}</figcaption>
          </figure>
        </div>

        <div class='profile-details'>
          <aside class='profile-contact' aria-labelledby={`contact-${authorIndex}`}>
            <h2 id={`contact-${authorIndex}`}>保持聯繫</h2>
            {author.socialLinks && <nav class='social-links' aria-label={`${author.name} 的社群連結`}>{Object.entries(author.socialLinks).map(([platform, url]) => <a href={url} target='_blank' rel='noopener noreferrer'><span>{platformLabel(platform)}</span><svg aria-hidden='true' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='m7 17 10-10M7 7h10v10' /></svg></a>)}</nav>}
            {author.programmingLanguages && <div class='language-notes'><h3>程式語言</h3><p>{author.programmingLanguages.join(' / ')}</p></div>}
          </aside>
          {author.description && <div class='author-description'>{author.description.split('\n\n').map(paragraph => <p>{paragraph}</p>)}</div>}
        </div>

        {(author.name === 'Jeremy' || author.portfolio?.length) && <section class='portfolio' aria-labelledby={`works-${authorIndex}`}>
          <header><h2 id={`works-${authorIndex}`}>作品與實作</h2></header>
          <div class='portfolio-list'>
            {author.name === 'Jeremy' && <a class='project studio-project' data-studio-project href='https://solunastre.com/' target='_blank' rel='noopener noreferrer'><div><h3>昭離工作室｜Solunastre Studio</h3><p>我的個人工作室，專門放自製商業產品。</p></div><svg aria-hidden='true' width='22' height='22' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='m7 17 10-10M7 7h10v10' /></svg></a>}
            {author.portfolio?.map(project => <a class='project' href={project.link} target='_blank' rel='noopener noreferrer'><div><h3>{project.name}</h3><p>{project.summary}</p></div><svg aria-hidden='true' width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='m7 17 10-10M7 7h10v10' /></svg></a>)}
          </div>
        </section>}
      </article>
    })}
  </div>
</Layout>

<style>
  .about-page { max-width: 1060px; margin-inline: auto; padding-bottom: 32px; }
  .about-heading { padding: 32px 0 54px; }
  h1 { margin: 0; font-family: var(--font-body); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.35; font-weight: 400; letter-spacing: -.015em; }
  .author-profile + .author-profile { margin-top: 96px; padding-top: 72px; border-top: 1px solid var(--color-line); }
  .profile-intro { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 88px; align-items: center; padding-bottom: 64px; border-bottom: 1px solid var(--color-line); }
  .profile-introduction { max-width: 640px; }
  .author-quote { margin: 0; }
  blockquote { margin: 0; font-family: var(--font-body); font-size: clamp(1.4rem, 2.3vw, 1.9rem); font-weight: 400; line-height: 1.7; letter-spacing: -.01em; text-wrap: balance; }
  .author-quote figcaption { margin-top: 20px; font-size: 12px; color: var(--color-ink-soft); line-height: 1.8; }
  .roles { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 30px 0 0; padding: 0; list-style: none; font-size: 13px; color: var(--color-ink-soft); line-height: 1.9; }
  .profile-portrait { width: 100%; margin: 0; }
  .profile-portrait img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-surface); }
  .profile-portrait figcaption { margin-top: 14px; font-size: 15px; line-height: 1.6; }
  .profile-details { display: grid; grid-template-columns: 216px minmax(0, 1fr); gap: 80px; padding-top: 64px; }
  .profile-contact h2, .portfolio > header h2 { font-family: var(--font-body); font-size: 1.2rem; line-height: 1.5; font-weight: 500; margin: 0 0 24px; }
  .social-links { display: grid; gap: 0; }
  .social-links a { display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 45px; padding: 9px 0; color: var(--color-ink); font-size: 14px; text-decoration: none; }
  .social-links a + a { border-top: 1px solid var(--color-line); }
  .social-links svg, .project svg { flex-shrink: 0; }
  .social-links a:hover span { text-decoration: underline; text-underline-offset: 5px; }
  .language-notes { margin-top: 32px; }
  .language-notes h3 { margin: 0 0 9px; font-size: 12px; font-weight: 500; color: var(--color-ink-soft); }
  .language-notes p { margin: 0; font-size: 13px; line-height: 1.9; color: var(--color-ink-soft); }
  .author-description { max-width: 70ch; }
  .author-description p { margin: 0 0 27px; font-size: 17px; line-height: 1.95; white-space: pre-line; color: var(--color-ink); }
  .author-description p:last-child { margin-bottom: 0; }
  .portfolio { display: grid; grid-template-columns: 216px minmax(0, 1fr); gap: 80px; margin-top: 80px; }
  .portfolio > header { padding-top: 25px; border-top: 1px solid var(--color-line); }
  .project { display: grid; grid-template-columns: minmax(0, 1fr) 22px; align-items: start; gap: 24px; padding: 27px 0 30px; border-top: 1px solid var(--color-line); text-decoration: none; color: var(--color-ink); }
  .project:last-child { border-bottom: 1px solid var(--color-line); }
  .project h3 { font-size: 1.13rem; font-weight: 500; line-height: 1.65; margin: 0 0 12px; }
  .studio-project h3 { font-size: clamp(1.2rem, 2vw, 1.4rem); }
  .project p { font-size: 14px; line-height: 1.9; color: var(--color-ink-soft); white-space: pre-line; margin: 0; }
  .project svg { margin-top: 5px; transition: transform .18s ease; }
  .project:hover h3 { text-decoration: underline; text-underline-offset: 5px; }
  .project:hover svg { transform: translate(2px, -2px); }
  .social-links a:focus-visible, .project:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 5px; }
  @media (max-width: 850px) {
    .profile-intro { grid-template-columns: 176px minmax(0, 1fr); gap: 24px 40px; align-items: start; padding-bottom: 48px; }
    .profile-introduction { display: contents; }
    .profile-portrait { grid-column: 1; grid-row: 1; }
    .roles { grid-column: 1; grid-row: 2; display: grid; gap: 6px; margin: 0; font-size: 13px; line-height: 1.6; }
    .author-quote { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    .profile-details, .portfolio { grid-template-columns: 170px minmax(0, 1fr); gap: 40px; }
    blockquote { font-size: 1.5rem; line-height: 1.6; text-wrap: pretty; }
  }
  @media (max-width: 600px) {
    .about-heading { padding: 16px 0 28px; }
    h1 { font-size: clamp(1.75rem, 8vw, 2rem); }
    .profile-intro { grid-template-columns: clamp(96px, 30vw, 128px) minmax(0, 1fr); gap: 26px 22px; align-items: center; padding-bottom: 32px; }
    .profile-portrait { width: 100%; }
    .profile-portrait figcaption { margin-top: 8px; font-size: 13px; }
    .roles { grid-column: 2; grid-row: 1; gap: 9px; font-size: 13px; line-height: 1.6; padding-bottom: 27px; }
    .author-quote { grid-column: 1 / -1; grid-row: 2; }
    blockquote { font-size: clamp(1.2rem, 5.5vw, 1.4rem); line-height: 1.6; }
    .author-quote figcaption { margin-top: 12px; font-size: 12px; }
    .profile-details { display: flex; flex-direction: column; gap: 32px; padding-top: 32px; }
    .author-description { order: -1; }
    .author-description p { font-size: 16px; line-height: 1.9; margin-bottom: 24px; }
    .profile-contact h2 { margin-bottom: 15px; }
    .social-links { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; }
    .social-links a { font-size: 14px; border-top: 1px solid var(--color-line); }
    .language-notes { margin-top: 24px; }
    .portfolio { grid-template-columns: 1fr; gap: 0; margin-top: 52px; }
    .portfolio > header { padding-top: 24px; }
    .portfolio > header h2 { margin-bottom: 24px; }
    .project { padding: 24px 0 27px; gap: 18px; }
    .project h3 { font-size: 1.08rem; }
    .studio-project h3 { font-size: 1.16rem; }
    .project p { font-size: 14px; line-height: 1.85; }
  }
  @media (prefers-reduced-motion: reduce) { .project svg { transition: none; } }
</style>
