---
import Layout from '@/layouts/Layout.astro'
import ArticleList from '@/components/ArticleList.astro'
import { getPublishedEntries, entryTimestamp } from '@/utils/content'
import { compareSortKeys } from '@/utils/sort'

const posts = await getPublishedEntries('blog')
const sortedPosts = [...posts].sort((a, b) => compareSortKeys(
  { time: entryTimestamp(b), sameDateSort: b.data.sameDateSort, title: b.data.title ?? '' },
  { time: entryTimestamp(a), sameDateSort: a.data.sameDateSort, title: a.data.title ?? '' },
))
---

<Layout title="文章" description="Jeremy 的文章與隨筆。日常、想像，與沿途的風景。">
  <div class="journal-page">
    <header><h1>文章與隨筆</h1><div class="journal-intro"><p>把日常寫下來，也讓想法慢慢生長。</p><span>{sortedPosts.length} 篇書寫</span></div></header>
    {sortedPosts.length > 0 ? <ArticleList posts={sortedPosts} /> : <p class="empty-note">新的書寫，慢慢整理中。</p>}
  </div>
</Layout>

<style>
  .journal-page { max-width: 960px; margin-inline: auto; }
  header { padding: 48px 0 50px; }
  h1 { font-family: var(--font-body); font-size: clamp(2.2rem, 4.2vw, 3.1rem); font-weight: 400; letter-spacing: .01em; line-height: 1.5; margin: 0 0 26px; }
  .journal-intro { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
  .journal-intro p { color: var(--color-ink-soft); font-size: 16px; line-height: 1.9; margin: 0; }
  .journal-intro > span { font-size: 12px; color: var(--color-ink-soft); white-space: nowrap; }
  .empty-note { padding: 35px 0; border-top: 1px solid var(--color-line); }
  @media(max-width: 640px) { header { padding: 28px 0 34px; } h1 { font-size: 2.2rem; margin-bottom: 18px; } .journal-intro { display: block; } .journal-intro p { font-size: 15px; } .journal-intro > span { display: block; margin-top: 18px; } }
</style>
