---
import Layout from '@/layouts/Layout.astro'
import ArticleList from '@/components/ArticleList.astro'
import InkSurface from '@/components/InkSurface.astro'
import { getPublishedEntries, entryTimestamp } from '@/utils/content'
import { compareSortKeys } from '@/utils/sort'

const [dailyPosts, notePosts] = await Promise.all([
  getPublishedEntries('blog'),
  getPublishedEntries('techbook')
])
const recentPosts = [...dailyPosts, ...notePosts].sort((a, b) => compareSortKeys(
  { time: -entryTimestamp(a), sameDateSort: a.data.sameDateSort, title: a.data.title ?? '' },
  { time: -entryTimestamp(b), sameDateSort: b.data.sameDateSort, title: b.data.title ?? '' },
)).slice(0, 6)
---

<Layout visualHome immersive title="Jeremy" description="Jeremy 的個人部落格。生活、思考與書寫。">
  <section class="ink-home" slot="cover" data-ink-cover aria-labelledby="home-heading" data-pagefind-ignore>
    <InkSurface />
    <div class="ink-intro" data-ink-intro>
      <div class="home-poem" data-home-poem>
        <p class="poem-preface">
          <span data-home-poem-line>雪沫乳花浮午盞，</span>
          <span data-home-poem-line>蓼茸蒿筍試春盤。</span>
        </p>
        <h1 id="home-heading" data-ink-intro-heading data-home-poem-line>人間有味是清歡。</h1>
      </div>
      <div class="ink-intro-actions">
        <a class="more-link" href="/about" data-ink-more>
          <span>閱讀更多</span>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>
  <div class="ink-home-content" data-pagefind-ignore>
    <section class="home-writing" id="writing" aria-labelledby="writing-heading" data-recent-writing>
      <div class="writing-inner">
        <div class="section-heading">
          <h2 id="writing-heading">最近的書寫</h2>
        </div>
        {recentPosts.length > 0 ? <ArticleList posts={recentPosts} visual showKind /> : <p class="empty-note">新的書寫，慢慢整理中。</p>}
      </div>
    </section>
  </div>
</Layout>

<style>
  .ink-home { position: relative; height: 100vh; height: 100svh; height: 100dvh; min-height: 100vh; min-height: 100lvh; flex-shrink: 0; overflow: hidden; isolation: isolate; background: var(--color-paper); }
  .ink-intro { position: absolute; z-index: 2; top: 31svh; left: max(var(--site-shell-gutter), calc((100% - var(--site-shell-max)) / 2)); width: min(32rem, calc(100% - 2 * var(--site-shell-gutter))); color: var(--color-ink); pointer-events: none; }
  .home-poem { font-family: var(--font-poem); font-weight: 400; }
  .home-poem, .more-link { text-shadow: 0 0 10px color-mix(in srgb, var(--color-paper) 24%, transparent); }
  .poem-preface { margin: 0 0 16px; font-family: inherit; font-size: clamp(26px, 2.1vw, 32px); font-weight: 400; line-height: 1.85; letter-spacing: .045em; }
  .poem-preface span { display: block; white-space: nowrap; }
  .ink-intro h1 { margin: 0; font-family: inherit; font-size: clamp(48px, 3.7vw, 56px); font-weight: 400; line-height: 1.65; letter-spacing: .035em; white-space: nowrap; }
  .ink-intro-actions { margin-top: 26px; }
  .more-link { display: inline-flex; align-items: center; gap: 28px; min-height: 46px; color: var(--color-ink); font-family: var(--font-body); font-size: 14px; line-height: 1.7; letter-spacing: .08em; text-decoration: none; pointer-events: auto; }
  .more-link span { padding-block: 5px; border-bottom: 1px solid var(--color-line); transition: border-color 180ms ease-out; }
  .more-link svg { flex-shrink: 0; transition: transform 180ms ease-out; }
  .more-link:hover span { border-color: currentColor; }
  .more-link:hover svg { transform: translateX(3px); }
  .more-link:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 6px; }
  .ink-home-content { background: var(--color-paper); color: var(--color-ink); }
  .home-writing { padding: 88px 0 112px; scroll-margin-top: 112px; }
  .writing-inner { width: min(1040px, calc(100% - 120px)); margin-inline: auto; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: 28px; margin-bottom: 32px; }
  h2 { font-family: var(--font-body); font-size: clamp(25px, 2.4vw, 32px); line-height: 1.5; font-weight: 400; margin: 0; letter-spacing: .01em; }
  .empty-note { margin: 0; padding: 32px 0; color: var(--color-ink-soft); font-size: 16px; }
  @media(max-width: 767px) {
    .ink-intro { top: max(164px, calc(22svh + 52px)); left: clamp(24px, 7vw, 30px); width: min(32rem, calc(100% - 2 * clamp(24px, 7vw, 30px))); }
    .poem-preface { margin-bottom: 16px; font-size: 24px; line-height: 1.75; letter-spacing: .025em; }
    .ink-intro h1 { font-size: clamp(34px, 10vw, 40px); line-height: 1.6; letter-spacing: .01em; }
    .ink-intro-actions { margin-top: 20px; }
    .more-link { gap: 24px; }
    .home-writing { padding: 52px 0 72px; }
    .writing-inner { width: calc(100% - 48px); }
    .section-heading { align-items: baseline; gap: 16px; margin-bottom: 24px; }
    h2 { font-size: 25px; }
  }
  @media(max-width: 360px) { .poem-preface { font-size: 22px; } .ink-intro h1 { font-size: 33px; } }
  @media(max-height: 620px) and (orientation: landscape), (max-height: 480px) { .ink-intro { top: max(124px, 22svh); } .poem-preface { font-size: 18px; line-height: 1.65; margin-bottom: 10px; } .ink-intro h1 { font-size: 30px; line-height: 1.55; } .ink-intro-actions { margin-top: 18px; } }
  @media(max-height: 620px) and (min-width: 768px) { .ink-intro { top: max(140px, 25svh); } .poem-preface { font-size: 24px; } .ink-intro h1 { font-size: 46px; } .ink-intro-actions { margin-top: 22px; } }
  @media(prefers-reduced-motion: reduce) { .more-link svg, .more-link span { transition: none; transform: none !important; } }
</style>
